{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "film.html",
      "use": "@vercel/static"
    },
    {
      "src": "404.html",
      "use": "@vercel/static"
    },
    {
      "src": "500.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/app.py"
    },
    {
      "src": "/",
      "dest": "index.html"
    },
    {
      "src": "/film",
      "dest": "film.html"
    },
    {
      "src": "/404",
      "dest": "404.html"
    },
    {
      "src": "/500",
      "dest": "500.html"
    },
    {
      "src": "/(.*)",
      "dest": "404.html",
      "status": 404
    }
  ]
}